{
  "name": "vscode-stem",
  "displayName": "Stem",
  "description": "Preview Stem rendered Markdown views inside VS Code.",
  "version": "0.4.0",
  "publisher": "stemdev",
  "author": "stemdev",
  "repository": {
    "type": "git",
    "url": "https://github.com/stemdev-hub/cli.git"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "pnpm --filter @stemdev/core build && esbuild extension.js --bundle --platform=node --target=node22 --format=cjs --external:vscode --outfile=dist/extension.js --metafile=dist/extension.meta.json",
    "test": "pnpm build && pnpm --filter @stemdev/cli build && vitest run",
    "typecheck": "pnpm --filter @stemdev/core build && tsc --noEmit",
    "vscode:prepublish": "pnpm build"
  },
  "devDependencies": {
    "@stemdev/core": "workspace:^",
    "@types/node": "22.15.30",
    "@types/vscode": "1.140.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "0.28.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "capabilities": {
    "virtualWorkspaces": {
      "supported": false
    },
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Stem requires a trusted workspace for preview and MCP setup."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "stem.previewToSide",
        "title": "Stem: Open Preview to Side",
        "icon": "$(open-preview)"
      },
      {
        "command": "stem.refreshPreview",
        "title": "Stem: Refresh Preview",
        "icon": "$(refresh)"
      },
      {
        "command": "stem.enableMcp",
        "title": "Stem: Enable AI Context Server (MCP)"
      }
    ],
    "configuration": {
      "title": "Stem",
      "properties": {
        "stem.cliPath": {
          "type": "string",
          "default": "",
          "description": "Legacy CLI path setting. Preview uses bundled core; MCP setup currently uses stem on PATH or npx and ignores this setting."
        },
        "stem.preview.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Automatically refresh open Stem previews when project files or unsaved editor contents change."
        },
        "stem.preview.refreshDebounceMs": {
          "type": "number",
          "default": 250,
          "minimum": 0,
          "description": "Delay in milliseconds before refreshing open Stem previews after a watched project file changes."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "stem.refreshPreview",
          "when": "resourceScheme == stem-preview && isWorkspaceTrusted",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "stem.previewToSide",
          "when": "editorLangId == markdown && isWorkspaceTrusted"
        },
        {
          "command": "stem.refreshPreview",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "stem.enableMcp",
          "when": "isWorkspaceTrusted"
        }
      ]
    }
  }
}
